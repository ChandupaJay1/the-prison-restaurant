# ==========================================================
# The Prison Restaurant & Lounge — Server Security (.htaccess)
# Secured by NerdTech Labs (http://nerdtechlabs.info/)
# ==========================================================

# 1. Disable directory listing (blocks browsing /images, /assets, /src)
Options -Indexes

# 2. Block direct access to source code, config, and hidden files
<FilesMatch "^(\.|package\.json|package-lock\.json|vite\.config\.js|tailwind\.config\.js|postcss\.config\.js|README\.md|LICENSE)">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    # Block direct HTTP requests to raw React source directory or git internals
    RewriteRule ^(src|node_modules|\.git)/ - [F,L]
</IfModule>

# 3. HTTP Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>
